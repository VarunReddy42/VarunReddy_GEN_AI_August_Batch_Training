# Real Kaggle job dataset and any resumes you test with can be large/
# personal — keep those out of git. Sample data and career notes we
# actually want tracked, so we exclude selectively rather than the
# whole data/ folder.
data/resumes/*
!data/resumes/.gitkeep
vectorstore/
.DS_Store
*.egg-info/
.ipynb_checkpoints/
